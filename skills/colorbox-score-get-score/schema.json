{
  "name": "score-getScore",
  "description": "获取指定业务对象的平均评分与打分人数（如球员、装备等）。当活动页内需要展示某一实体的打分状态时调用。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "outBizType": {
        "type": "string",
        "description": "业务类型。常用可选值包括：nbaPlayer (NBA球员), cbaPlayer (CBA球员), equipment (运动装备), games (游戏), movie (电影影视), food (美食), school (高校)"
      },
      "outBizNo": {
        "type": "string",
        "description": "业务对象 ID，例如球员 ID"
      }
    },
    "required": [
      "outBizType",
      "outBizNo"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "业务状态码，1 表示成功"
      },
      "type": {
        "type": "string",
        "description": "响应类型，例如 COMMON"
      },
      "msg": {
        "type": "string",
        "description": "提示信息，例如 \"成功\""
      },
      "success": {
        "type": "boolean",
        "description": "是否请求成功"
      },
      "data": {
        "type": "object",
        "description": "评分数据主体",
        "properties": {
          "nodeId": {
            "type": "number",
            "description": "当前评分节点 ID"
          },
          "linkNodes": {
            "type": "array",
            "description": "关联节点/面包屑导航列表",
            "items": {
              "type": "object",
              "properties": {
                "nodeId": {
                  "type": "number",
                  "description": "节点 ID"
                },
                "parentNodeId": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "父节点 ID，可能为 null"
                },
                "level": {
                  "type": "number",
                  "description": "节点层级"
                },
                "desc": {
                  "type": "string",
                  "description": "节点描述/名称"
                },
                "target": {
                  "type": "string",
                  "description": "跳转目标类型，例如 GROUP"
                },
                "outBizKey": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "外部业务标识，可能为 null"
                },
                "schema": {
                  "type": "string",
                  "description": "跳转 schema 链接"
                }
              }
            }
          },
          "groupInfo": {
            "type": "object",
            "description": "所属榜单/分组信息",
            "properties": {
              "groupId": {
                "type": "number",
                "description": "分组 ID"
              },
              "nodeId": {
                "type": "number",
                "description": "分组对应节点 ID"
              },
              "groupName": {
                "type": "string",
                "description": "分组名称"
              },
              "jumpUrl": {
                "type": "string",
                "description": "分组跳转链接"
              },
              "publishNum": {
                "type": "number",
                "description": "已发布数量"
              },
              "recommendDesc": {
                "type": "string",
                "description": "推荐描述"
              },
              "publishTime": {
                "type": "string",
                "description": "发布时间（格式化字符串，如 07-13）"
              },
              "publishTimeTs": {
                "type": "number",
                "description": "发布时间戳（毫秒）"
              },
              "creatorUser": {
                "type": "number",
