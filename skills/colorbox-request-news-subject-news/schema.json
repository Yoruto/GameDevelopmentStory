{
  "name": "request-news-subjectNews",
  "description": "查询专题（Subject）关联的新闻列表信息。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "newsId": {
        "type": "string",
        "description": "新闻帖唯一ID，例如 \"22224850\""
      }
    },
    "required": [
      "newsId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "状态码。200 表示成功，401 表示未登录，404 表示内容不存在，500 表示服务器错误"
      },
      "message": {
        "type": "string",
        "description": "错误提示信息。当 code 不等于 200 时必须用于向用户友好提示"
      },
      "data": {
        "type": "object",
        "description": "成功时返回的数据载荷",
        "properties": {
          "nid": {
            "type": "string",
            "description": "专题 ID"
          },
          "signboard": {
            "type": "string",
            "description": "专题标识文案，如 \"专题\""
          },
          "title": {
            "type": "string",
            "description": "专题标题"
          },
          "img": {
            "type": "string",
            "description": "专题封面图 URL"
          },
          "replies": {
            "type": "number",
            "description": "专题总评论数"
          },
          "lights": {
            "type": "number",
            "description": "专题总亮评/点赞数"
          },
          "newsCount": {
            "type": "number",
            "description": "专题关联新闻总数"
          },
          "groups": {
            "type": "array",
            "description": "按场次/主题划分的新闻分组列表",
            "items": {
              "type": "object",
              "description": "专题下的新闻分组（如按场次）",
              "properties": {
                "orderBy": {
                  "type": "string",
                  "description": "分组排序序号，如 \"1\""
                },
                "title": {
                  "type": "string",
                  "description": "分组标题，如 \"奇才92-88爵士\""
                },
                "news": {
                  "type": "array",
                  "description": "该分组下的新闻列表",
                  "items": {
                    "type": "object",
                    "description": "专题分组内的单条新闻",
                    "properties": {
                      "nid": {
                        "type": "string",
                        "description": "新闻 ID"
                      },
                      "tid": {
                        "type": "string",
                        "description": "帖子/话题 ID"
                      },
                      "type": {
                        "type": "string",
                        "description": "新闻类型，如 \"IMG_TEXT\""
                      },
                      "title": {
                        "type": "string",
                        "description": "新闻标题"
                      },
                      "img": {
                        "type": "string",
                        "description": "封面图 URL"
                      },
                      "replies": {
                        "type": "number",
                        "description": "评论数"
                      },
                      "lights": {
                        "type": "number",
                        "description": "亮评/点赞数"
                      },
                      "link": {
                        "type": "string",
                        "description": "跳转链接（如 kanqiu://bbs/topic/...）"
                      },
                      "linkType": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "description": "链接类型（可能为 null）"
                      },
                      "badge": {
                        "type": "array",
                        "description": "角标列表",
                        "items": {
                          "type": "object"
                        }
                      },
                      "publishTime": {
                        "type": "string",
                        "description": "发布时间，如 \"2026-07-10 11:08:58\""
                      },
                      "addTime": {
                        "type": "number",
                        "description": "添加时间戳"
                      },
                      "oldNewsId": {
                        "type": "string",
                        "description": "旧新闻 ID"
                      },
                      "top": {
                        "type": "boolean",
                        "description": "是否置顶"
                      },
                      "pv": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "阅读量（可能为 null）"
                      },
                      "gifList": {
                        "type": [
                          "array",
                          "null"
                        ],
                        "description": "GIF 列表（可能为 null）"
                      },
                      "read": {
                        "type": "string",
                        "description": "已读标识，通常与 nid 相同"
                      },
                      "showComment": {
                        "type": "number",
                        "description": "是否展示评论，1 表示展示"
                      }
                    }
                  }
                }
              }
            }
          },
          "share": {
            "type": "object",
            "description": "分享信息",
            "properties": {
              "url": {
                "type": "string",
                "description": "分享落地页 URL"
              },
              "summary": {
                "type": "string",
                "description": "分享摘要"
              },
              "img": {
                "type": "string",
                "description": "分享图片 URL"
              },
              "title": {
                "type": "string",
                "description": "分享标题"
              }
            }
          }
        }
      }
    },
    "required": [
      "code",
      "message"
    ]
  }
}