                            },
                            "content": {
                              "type": "string",
                              "description": "被引用回复内容"
                            },
                            "togglecontent": {
                              "type": "string|null",
                              "description": "折叠/展开内容，可能为 null"
                            },
                            "attr": {
                              "type": "string",
                              "description": "引用回复扩展属性序列化字符串"
                            },
                            "videoInfo": {
                              "type": "object|null",
                              "description": "引用回复视频信息，可能为 null"
                            },
                            "ancillaryContents": {
                              "type": "array|null",
                              "description": "引用回复附属内容，可能为 null"
                            },
                            "pid": {
                              "type": "number",
