# 云服务凭据（敏感，不入库；仅部署阶段读取）
credentials.json

# Cursor 从 .cursor/skills 发现技能；该目录是指向 skills/ 的本地 junction，不入库
.cursor/skills

# 运行状态与本地产物
state/*.json
skills/runbook/state/
__pycache__/
*.pyc

# 本地云查询快照（不是凭据，但也不入库）
env-detail.json

# WorkBuddy 智能体工作区（记忆/技能/临时产物），不入库
.workbuddy/

# 事件文案批量改写前的本地快照（还原点；历史本身已在 git 里）
scripts/_cw_*.json

# 阶段探针 / patch 前备份 / 阶段 API 快照 / 验证截图 / 临时分析（工作区共存但不入仓）
# 通用兜底：scripts/ 下所有 _ 前缀文件默认忽略（探针、备份、截图、检查输出、分析脚本）
scripts/_*
# 例外：3 个 production patch 脚本（_patch_development_assignment / _patch_promotion_gate /
# _patch_promotion_stat_only），跟其他 patch_*.py 同质用于追溯历史变更
!scripts/_patch_*.py
