{
  "name": "request-activity-submitVote",
  "description": "提交互动投票，支持对指定的活动、分组以及候选项进行投票。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "activityId": {
        "type": "number",
        "description": "投票活动唯一ID，例如 1"
      },
      "groupId": {
        "type": "number",
        "description": "投票分组唯一ID，例如 5"
      },
      "itemId": {
        "type": "number",
        "description": "候选项唯一ID，例如 14"
      },
      "voteNum": {
        "type": "number",
        "description": "投票票数，默认为 1"
      }
    },
    "required": [
      "activityId",
      "groupId",
      "itemId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "状态码。200 表示成功，401 表示未登录，404 表示内容不存在，500 表示服务器错误"
      },
      "message": {
        "type": "string",
        "description": "错误提示信息。当 code 不等于 200 时必须用于向用户友好提示"
      },
      "data": {
        "type": "object",
        "description": "成功时返回的数据载荷",
        "properties": {
          "succeed": {
            "type": "boolean",
            "description": "是否投票成功"
          }
        }
      }
    },
    "required": [
      "code",
      "message"
    ]
  }
}