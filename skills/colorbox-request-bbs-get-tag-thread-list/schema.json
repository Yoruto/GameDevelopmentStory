{
  "name": "request-bbs-getTagThreadList",
  "description": "拉取指定话题（Tag）下某个 Tab 的帖子列表，支持分页、游标加载以及场景/活动标识上报。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "tagId": {
        "type": "string",
        "description": "话题 ID，来自话题详情的 tagId，如 \"152660\""
      },
      "tabType": {
        "type": "string",
        "description": "Tab 类型，如 \"1\" 为最新发布，\"2\" 为最新回复"
      },
      "page": {
        "type": "number",
        "description": "分页页码，从 1 开始，刷新时传 1，之后递增"
      },
      "lastCursor": {
        "type": "string",
        "description": "上一页返回的游标，首页传空串 \"\""
      },
      "scene": {
        "type": "string",
        "description": "可选，场景标识（活动/运营场景）"
      },
      "activityId": {
        "type": "string",
        "description": "可选，活动 ID，用于埋点区分"
      }
    },
    "required": [
      "tagId",
      "tabType",
      "page",
      "lastCursor"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "状态码。200 表示成功，401 表示未登录，404 表示内容不存在，500 表示服务器错误"
      },
      "message": {
        "type": "string",
        "description": "错误提示信息。当 code 不等于 200 时必须用于向用户友好提示"
      },
      "data": {
        "type": "object",
        "description": "成功时返回的数据载荷",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "下一页请求的游标，加载更多时传给 lastCursor"
          },
          "nextPage": {
            "type": "boolean",
            "description": "是否还有下一页"
          },
          "next_page": {
            "type": "number",
            "description": "兼容旧分页字段；优先使用 nextPage 判断是否还有更多数据"
          },
          "stamp": {
            "type": "number|null",
            "description": "分页时间戳/服务端返回的列表标记，可能为 null"
          },
          "total": {
            "type": "number|null",
            "description": "总数，接口可能返回 null"
          },
          "list": {
            "type": "array",
            "description": "帖子列表数组",
            "items": {
              "type": "object",
              "properties": {
                "tid": {
                  "type": "number",
                  "description": "帖子唯一 ID"
                },
                "title": {
                  "type": "string",
                  "description": "帖子标题"
                },
                "summary": {
                  "type": "string",
                  "description": "帖子摘要/正文截断内容，可能为空字符串"
                },
                "puid": {
                  "type": "number",
                  "description": "发帖人 PUID"
                },
                "fid": {
                  "type": "number",
                  "description": "论坛版块 ID"
                },
                "replies": {
                  "type": "number",
                  "description": "回复数"
                },
                "repliesDesc": {
                  "type": "string|null",
                  "description": "回复数展示文案，可能为 null"
                },
                "userName": {
                  "type": "string",
                  "description": "发帖人昵称"
                },
                "userHeader": {
                  "type": "string",
                  "description": "发帖人头像 URL"
                },
                "time": {
                  "type": "string",
                  "description": "帖子展示时间，如 \"07-19\""
                },
                "createTime": {
                  "type": "number",
                  "description": "发帖时间戳"
                },
                "lastPostTime": {
                  "type": "number",
                  "description": "最后回复/更新时间戳"
                },
                "recommendCount": {
                  "type": "number",
                  "description": "推荐/亮了数量"
                },
                "shareNum": {
                  "type": "number",
                  "description": "分享数"
                },
                "topicId": {
                  "type": "number",
                  "description": "帖子所属话题/专区 ID"
                },
                "topicName": {
                  "type": "string",
                  "description": "帖子所属话题/专区名称"
                },
                "topicIcon": {
                  "type": "string",
                  "description": "帖子所属话题/专区图标 URL"
                },
                "topThread": {
                  "type": "boolean",
                  "description": "是否置顶帖"
                },
                "specialIdentifyPics": {
                  "type": "string|null",
                  "description": "特殊标识图片 URL，可能为 null"
                },
                "nightSpecialIdentifyPics": {
                  "type": "string|null",
                  "description": "夜间模式特殊标识图片 URL，可能为 null"
                },
                "specialIdentifyPicsWidth": {
                  "type": "number|null",
                  "description": "特殊标识图片宽度，可能为 null"
                },
                "specialIdentifyPicsHeight": {
                  "type": "number|null",
                  "description": "特殊标识图片高度，可能为 null"
                },
                "videoThread": {
                  "type": "boolean",
                  "description": "是否视频帖"
                },
                "jumpUrl": {
                  "type": "string",
                  "description": "帖子跳转 Schema/链接"
                },
                "video": {
                  "type": "object|null",
                  "description": "视频信息；非视频帖为 null",
                  "properties": {
                    "duration": {
                      "type": "number",
                      "description": "视频时长，单位秒"
                    },
                    "vid": {
                      "type": "number",
                      "description": "视频 ID"
                    },
                    "img": {
                      "type": "string",
                      "description": "视频封面 URL"
                    },
                    "size": {
                      "type": "number",
                      "description": "视频大小，单位字节"
                    },
                    "width": {
                      "type": "number",
                      "description": "视频宽度"
                    },
                    "play_num": {
                      "type": "number",
                      "description": "播放数"
                    },
                    "url": {
                      "type": "string",
                      "description": "视频播放 URL"
                    },
                    "bullet_comment_num": {
                      "type": "number",
                      "description": "弹幕数"
                    },
                    "height": {
                      "type": "number",
                      "description": "视频高度"
                    },
                    "humanDuration": {
                      "type": "string",
                      "description": "格式化视频时长，如 \"4:04\""
                    },
                    "humanSize": {
                      "type": "string",
                      "description": "格式化视频大小，如 \"29MB\""
                    }
                  }
                },
                "picList": {
                  "type": "array",
                  "description": "图片列表",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "图片 URL"
                      },
                      "is_gif": {
                        "type": "number",
                        "description": "是否 GIF，0 表示否，1 表示是"
                      },
                      "width": {
                        "type": "number",
                        "description": "图片宽度"
                      },
                      "height": {
                        "type": "number",
                        "description": "图片高度"
                      },
                      "type": {
                        "type": "string",
                        "description": "图片类型，如 common"
                      },
                      "videoUrl": {
                        "type": "string|null",
                        "description": "图片关联视频 URL，可能为 null"
                      }
                    }
                  }
                },
                "containPic": {
                  "type": "boolean",
                  "description": "是否包含图片"
                },
                "lightReplyResult": {
                  "type": "object|null",
                  "description": "亮评信息；无亮评时为 null",
