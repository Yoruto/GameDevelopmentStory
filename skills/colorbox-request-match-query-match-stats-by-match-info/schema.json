{
  "name": "request-match-queryMatchStatsByMatchInfo",
  "description": "查询通用赛事直播间的详细战态统计数据（如每局对局比分、战绩等）。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "matchId": {
        "type": "string",
        "description": "比赛唯一ID，例如 \"1441778164564949277\""
      },
      "boNumber": {
        "type": "number",
        "description": "第几局（0表示全场数据，1, 2, 3...表示单局对局，默认为 0）"
      }
    },
    "required": [
      "matchId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "状态码。200 表示成功，401 表示未登录，404 表示内容不存在，500 表示服务器错误"
      },
      "message": {
        "type": "string",
        "description": "错误提示信息。当 code 不等于 200 时必须用于向用户友好提示"
      },
      "data": {
        "type": "object",
        "description": "成功时返回的数据载荷",
        "properties": {
          "stats": {
            "type": "array",
            "description": "统计组件列表，每个元素对应一个可渲染的统计模块",
            "items": {
              "type": "object",
              "properties": {
                "componentCode": {
                  "type": "string",
                  "description": "组件类型标识（如 list_display_components_fix_row 固定行列表、bo_components 分盘切换、horizontal_display_with_stats 横向数据统计）"
                },
                "defaultAnchor": {
                  "type": "number",
                  "description": "默认选中锚点索引（可能为 null）"
                },
                "belongingCamp": {
                  "type": "string",
                  "description": "所属阵营（可能为 null）"
                },
                "headingInfo": {
                  "type": "object",
                  "description": "表头信息",
                  "properties": {
                    "tableDataInfo": {
                      "type": "array",
                      "description": "表头单元格列表",
                      "items": {
                        "type": "object",
                        "description": "统计单元格",
                        "properties": {
                          "showName": {
                            "type": "string",
                            "description": "展示文案（如球员名、比分、百分比等，无则为空字符串）"
                          },
                          "logo": {
                            "type": "string",
                            "description": "Logo/头像图片 URL（无则为空字符串）"
                          },
                          "bg": {
                            "type": "string",
                            "description": "背景图（可能为 null）"
                          },
                          "requestValue": {
                            "type": "string",
                            "description": "请求参数值（如盘次索引，可能为 null）"
                          },
                          "sourceData": {
                            "type": "number",
                            "description": "原始数值，用于排序或比较（可能为 null）"
                          },
                          "baikeLink": {
                            "type": "string",
                            "description": "百科/资料页跳转链接（可能为 null）"
                          },
                          "fontColor": {
                            "type": "string",
                            "description": "字体颜色（可能为 null）"
                          },
                          "bgColor": {
                            "type": "string",
                            "description": "背景颜色（可能为 null）"
                          }
                        }
                      }
                    },
                    "memberPosition": {
                      "type": "string",
                      "description": "成员位置（如 home、away，表头通常为 null）"
                    },
                    "memberWinStatus": {
                      "type": "boolean",
                      "description": "成员是否获胜（表头通常为 null）"
                    }
                  }
                },
                "bodyInfo": {
                  "type": "array",
                  "description": "表体行列表（可能为 null）",
                  "items": {
                    "type": "object",
                    "properties": {
                      "bodyDataInfo": {
                        "type": "array",
                        "description": "当前行的单元格列表",
                        "items": {
                          "type": "object",
                          "description": "统计单元格",
                          "properties": {
                            "showName": {
                              "type": "string",
                              "description": "展示文案（如球员名、比分、百分比等，无则为空字符串）"
                            },
                            "logo": {
                              "type": "string",
                              "description": "Logo/头像图片 URL（无则为空字符串）"
                            },
                            "bg": {
                              "type": "string",
                              "description": "背景图（可能为 null）"
                            },
                            "requestValue": {
                              "type": "string",
                              "description": "请求参数值（如盘次索引，可能为 null）"
                            },
                            "sourceData": {
                              "type": "number",
                              "description": "原始数值，用于排序或比较（可能为 null）"
                            },
                            "baikeLink": {
                              "type": "string",
                              "description": "百科/资料页跳转链接（可能为 null）"
                            },
                            "fontColor": {
                              "type": "string",
                              "description": "字体颜色（可能为 null）"
                            },
                            "bgColor": {
                              "type": "string",
                              "description": "背景颜色（可能为 null）"
                            }
                          }
                        }
                      },
                      "memberPosition": {
                        "type": "string",
                        "description": "成员位置（如 home 主、away 客）"
                      },
                      "memberWinStatus": {
                        "type": "boolean",
                        "description": "该成员是否获胜"
                      }
                    }
                  }
                },
                "separatorInfo": {
                  "type": "object",
                  "description": "分隔符信息（可能为 null）"
                }
              }
            }
          },
          "pollingConfig": {
            "type": "object",
            "description": "轮询配置（可能为 null）"
          }
        }
      }
    },
    "required": [
      "code",
      "message"
    ]
  }
}