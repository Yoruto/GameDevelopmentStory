{
  "name": "request-basketball-singleMatch",
  "description": "获取篮球单场比赛的详细数据，包括双方队伍名称、队徽、比分、比赛状态等。当需要读取并显示特定篮球比赛的赛况时调用。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "matchId": {
        "type": "string",
        "description": "比赛唯一ID，例如 \"1500260599135731712\""
      }
    },
    "required": [
      "matchId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "状态码。200 表示成功，401 表示未登录，404 表示内容不存在，500 表示服务器错误"
      },
      "message": {
        "type": "string",
        "description": "错误提示信息。当 code 不等于 200 时必须用于向用户友好提示"
      },
      "data": {
        "type": "object",
        "description": "成功时返回的数据载荷",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "项目ID（内部字段，通常为 null）"
          },
          "version": {
            "type": "string",
            "description": "版本号（内部字段，通常为 null）"
          },
          "traceId": {
            "type": "string",
            "description": "链路追踪ID（内部字段，通常为 null）"
          },
          "matchId": {
            "type": "string",
            "description": "比赛唯一ID"
          },
          "matchStatus": {
            "type": "string",
            "description": "比赛状态（如 COMPLETED, LIVE, NOT_STARTED 等）"
          },
          "homeScore": {
            "type": "number",
            "description": "主队得分"
          },
          "awayScore": {
            "type": "number",
            "description": "客队得分"
          },
          "homeTeamId": {
            "type": "string",
            "description": "主队ID"
          },
          "awayTeamId": {
            "type": "string",
            "description": "客队ID"
          },
          "homeTeamName": {
            "type": "string",
            "description": "主队简称（中文）"
          },
          "awayTeamName": {
            "type": "string",
            "description": "客队简称（中文）"
          },
          "homeTeamEngName": {
            "type": "string",
            "description": "主队英文名（可能为 null）"
          },
          "awayTeamEngName": {
            "type": "string",
            "description": "客队英文名（可能为 null）"
          },
          "homeTeamLogo": {
            "type": "string",
            "description": "主队队徽图片 URL"
          },
          "awayTeamLogo": {
            "type": "string",
            "description": "客队队徽图片 URL"
          },
          "homeTeamDayColor": {
            "type": "string",
            "description": "主队日间主题色（十六进制，无 # 前缀）"
          },
          "awayTeamDayColor": {
            "type": "string",
            "description": "客队日间主题色（十六进制，无 # 前缀）"
          },
          "homeTeamNightColor": {
            "type": "string",
            "description": "主队夜间主题色"
          },
          "awayTeamNightColor": {
            "type": "string",
            "description": "客队夜间主题色"
          },
          "homeTeamSpareColor": {
            "type": "string",
            "description": "主队备用主题色"
          },
          "awayTeamSpareColor": {
            "type": "string",
            "description": "客队备用主题色"
          },
          "homeFrontTeam": {
            "type": "boolean",
            "description": "主队是否为前置展示队伍"
          },
          "snapshotVersion": {
            "type": "number",
            "description": "数据快照版本号"
          },
          "leagueType": {
            "type": "string",
            "description": "联赛类型（如 CBA, NBA）"
          },
          "competitionType": {
            "type": "string",
            "description": "赛事类型（如 CBA）"
          },
          "competitionTypeCn": {
            "type": "string",
            "description": "赛事类型中文名（如 CBA）"
          },
          "competitionStageType": {
            "type": "string",
            "description": "比赛阶段类型（如 PLAYOFF、REGULAR）"
          },
          "competitionStageDesc": {
            "type": "string",
            "description": "比赛阶段描述（如 季后赛、常规赛）"
          },
          "gdcId": {
            "type": "number",
            "description": "GDC 数据中心比赛ID"
          },
          "beginTime": {
            "type": "number",
            "description": "比赛开始时间（纳秒时间戳）"
          },
          "homeGdcId": {
            "type": "number",
            "description": "主队 GDC ID"
          },
          "awayGdcId": {
            "type": "number",
            "description": "客队 GDC ID"
          },
          "homeFouls": {
            "type": "number",
            "description": "主队犯规数"
          },
          "homeSurplusPause": {
            "type": "number",
            "description": "主队剩余暂停次数"
          },
          "awayFouls": {
            "type": "number",
            "description": "客队犯规数"
          },
          "awaySurplusPause": {
            "type": "number",
            "description": "客队剩余暂停次数"
          },
          "matchStatusChinese": {
            "type": "string",
            "description": "比赛状态中文描述（如 已结束、直播中、未开始）"
          },
          "homeRank": {
            "type": "number",
            "description": "主队排名"
          },
          "awayRank": {
            "type": "number",
            "description": "客队排名"
          },
          "homeArea": {
            "type": "string",
            "description": "主队地区（可能为 null）"
          },
          "awayArea": {
            "type": "string",
            "description": "客队地区（可能为 null）"
          },
          "frontEndMatchStatus": {
            "type": "object",
            "description": "前端比赛状态",
            "properties": {
              "id": {
                "type": "number",
                "description": "状态ID"
              },
              "desc": {
                "type": "string",
                "description": "状态描述（如 已结束）"
              }
            }
          },
          "matchTimeScheduleStatus": {
            "type": "string",
            "description": "比赛时间安排状态（如 SCHEDULED）"
          },
          "attendance": {
            "type": "number",
            "description": "观众人数（可能为 null）"
          },
          "season": {
            "type": "string",
            "description": "赛季（如 2025-2026）"
          },
          "memo": {
            "type": "string",
            "description": "备注信息（可能为 null）"
          },
          "arenaCity": {
            "type": "string",
            "description": "比赛场馆所在城市（可能为 null）"
          },
          "chinaStartTime": {
            "type": "number",
            "description": "中国时区开赛时间（毫秒时间戳）"
          },
          "usaStartTime": {
            "type": "number",
            "description": "美国时区开赛时间（毫秒时间戳，可能为 null）"
          },
          "matchTime": {
            "type": "string",
            "description": "比赛时间字符串（如 \"2026-05-07 20:00:00\"）"
          },
          "costTime": {
            "type": "number",
            "description": "比赛耗时（可能为 null）"
          },
          "currentQuarter": {
            "type": "number",
            "description": "当前节数"
          },
          "round": {
            "type": "number",
            "description": "轮次"
          },
          "winTeamName": {
            "type": "string",
            "description": "获胜队伍简称"
          },
          "openChat": {
            "type": "boolean",
            "description": "是否开启聊天"
          },
          "openLive": {
            "type": "boolean",
            "description": "是否开启直播"
          },
          "openCasino": {
            "type": "boolean",
            "description": "是否开启竞猜"
          },
          "playerscorecount": {
            "type": "number",
            "description": "球员评分人数（可能为 null）"
          },
          "liveOption": {
            "type": "string",
            "description": "直播方式（如 ARTIFICIAL 人工）"
          },
          "lid": {
            "type": "string",
            "description": "联赛ID"
          },
          "matchTvList": {
            "type": "array",
            "description": "电视转播列表"
          },
          "matchVideoList": {
            "type": "array",
            "description": "比赛视频列表"
          },
          "liveUrl": {
            "type": "string",
            "description": "直播间跳转链接"
          },
          "iconText": {
            "type": "string",
            "description": "角标文案（如 \"5.8万\"）"
          },
          "score": {
            "type": "string",
            "description": "比赛评分（如 \"5.8万评分\"）"
          },
          "scoreNumber": {
            "type": "number",
            "description": "评分人数"
          },
          "sectionEndTime": {
            "type": "string",
            "description": "各节结束时间（JSON 字符串）"
          },
          "homeBigScore": {
            "type": "number",
            "description": "主队大比分"
          },
          "awayBigScore": {
            "type": "number",
            "description": "客队大比分"
          },
          "isSubscribe": {
            "type": "number",
            "description": "是否已订阅（0/1）"
          },
          "homeTeamAttention": {
            "type": "number",
            "description": "主队关注状态（可能为 null）"
          },
          "awayTeamAttention": {
            "type": "number",
            "description": "客队关注状态（可能为 null）"
          },
          "shareImg": {
            "type": "string",
            "description": "分享图片 URL"
          },
          "showSubscribe": {
            "type": "boolean",
            "description": "是否展示订阅按钮"
          },
          "didSubscribe": {
            "type": "boolean",
            "description": "是否已订阅"
          },
          "subScribeTitle": {
            "type": "string",
            "description": "订阅标题"
          },
          "subScribeType": {
            "type": "string",
            "description": "订阅类型（如 matchNotice）"
          },
          "subScribeScene": {
            "type": "string",
            "description": "订阅场景（如 basketballMatchNotice）"
          },
          "subScribeBizType": {
            "type": "string",
            "description": "订阅业务类型（如 basketballMatch）"
          },
          "subScribeDesc": {
            "type": "string",
            "description": "订阅描述（如 \"深圳 vs 浙江\"）"
          },
          "liveRoomMsgConfig": {
            "type": "object",
            "description": "直播间消息配置",
            "properties": {
              "polling": {
                "type": "object",
                "description": "轮询配置",
                "properties": {
                  "open": {
                    "type": "boolean",
                    "description": "是否开启轮询"
                  },
                  "inProgressIntervalInMillSeconds": {
                    "type": "number",
                    "description": "进行中轮询间隔（毫秒）"
                  },
                  "notInProgressIntervalInMillSeconds": {
                    "type": "number",
                    "description": "非进行中轮询间隔（毫秒）"
                  }
                }
              },
              "mqtt": {
                "type": "object",
                "description": "MQTT 配置",
                "properties": {
                  "open": {
                    "type": "boolean",
                    "description": "是否开启 MQTT"
                  }
                }
              }
            }
          },
          "supportLiveActivity": {
            "type": "boolean",
            "description": "是否支持灵动岛实时活动"
          },
          "matchSpecimens": {
            "type": "array",
            "description": "比赛样本数据（可能为 null）"
          },
          "homeLink": {
            "type": "string",
            "description": "主队详情跳转链接"
          },
          "awayLink": {
            "type": "string",
            "description": "客队详情跳转链接"
          },
          "iosliveActivityCode": {
            "type": "string",
            "description": "iOS 实时活动编码（可能为 null）"
          },
          "is_login": {
            "type": "number",
            "description": "是否登录（0/1）"
          },
          "is_jrs": {
            "type": "boolean",
            "description": "是否为极速版"
          },
          "night": {
            "type": "number",
            "description": "是否夜间模式（0/1）"
          },
          "client": {
            "type": "string",
            "description": "客户端标识（可能为 null）"
          },
          "league_en": {
            "type": "string",
            "description": "联赛英文标识（如 cba）"
          },
          "league_name": {
            "type": "string",
            "description": "联赛名称（如 CBA）"
          },
          "ad_inside_pop": {
            "type": "object",
            "description": "内部广告弹窗配置",
            "properties": {
              "ad_type": {
                "type": "number",
                "description": "广告类型"
              },
              "is_ad": {
                "type": "number",
                "description": "是否为广告（0/1）"
              },
              "position": {
                "type": "number",
                "description": "广告位置"
              }
            }
          }
        }
      }
    },
    "required": [
      "code",
      "message"
    ]
  }
}