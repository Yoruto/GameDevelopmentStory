                        },
                        "tid": {
                          "type": "number",
                          "description": "亮评所属帖子 ID"
                        },
                        "aid": {
                          "type": "number|null",
                          "description": "亮评 aid，可能为 null"
                        },
                        "puid": {
                          "type": "number",
                          "description": "亮评用户 PUID"
                        },
                        "username": {
                          "type": "string",
                          "description": "亮评用户昵称"
                        },
                        "user_ip": {
                          "type": "string",
                          "description": "亮评用户 IP"
                        },
                        "via": {
                          "type": "number",
                          "description": "亮评来源端标识"
                        },
                        "content": {
                          "type": "string",
                          "description": "亮评内容"
                        },
                        "quote": {
                          "type": "object|null",
                          "description": "引用回复信息；无引用时为 null",
                          "properties": {
                            "rerferInfo": {
                              "type": "object",
