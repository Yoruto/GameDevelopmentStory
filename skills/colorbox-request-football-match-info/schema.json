{
  "name": "request-football-matchInfo",
  "description": "获取足球单场比赛的详细数据，包括双方队伍名称、队徽、比分、比赛状态等。当需要读取并显示特定足球比赛的赛况时调用。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "matchId": {
        "type": "string",
        "description": "比赛唯一ID，例如 \"3512534\""
      }
    },
    "required": [
      "matchId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "状态码。200 表示成功，401 表示未登录，404 表示内容不存在，500 表示服务器错误"
      },
      "message": {
        "type": "string",
        "description": "错误提示信息。当 code 不等于 200 时必须用于向用户友好提示"
      },
      "data": {
        "type": "object",
        "description": "成功时返回的数据载荷",
        "properties": {
          "date": {
            "type": "string",
            "description": "比赛日期时间（如 \"2026-07-10 04:00:00\"）"
          },
          "matchId": {
            "type": "number",
            "description": "比赛唯一ID"
          },
          "oldMatchId": {
            "type": "number",
            "description": "旧比赛ID（可能为 null）"
          },
          "competitionName": {
            "type": "string",
            "description": "赛事名称（如 世界杯）"
          },
          "competitionShortName": {
            "type": "string",
            "description": "赛事简称（如 世界杯）"
          },
          "gdcLid": {
            "type": "string",
            "description": "GDC 联赛ID"
          },
          "league": {
            "type": "boolean",
            "description": "是否为联赛"
          },
          "stageName": {
            "type": "string",
            "description": "阶段名称（如 1/4决赛）"
          },
          "round": {
            "type": "number",
            "description": "轮次"
          },
          "homeLogo": {
            "type": "string",
            "description": "主队队徽图片 URL"
          },
          "homeTeamId": {
            "type": "number",
            "description": "主队ID"
          },
          "oldHomeTeamId": {
            "type": "number",
            "description": "旧主队ID"
          },
          "homeTeamName": {
            "type": "string",
            "description": "主队名称（如 法国）"
          },
          "homeTeamShortNameEn": {
            "type": "string",
            "description": "主队英文简称（如 France）"
          },
          "homeScore": {
            "type": "number",
            "description": "主队比分"
          },
          "homeOutScore": {
            "type": "number",
            "description": "主队常规时间外比分（加时/点球）"
          },
          "awayLogo": {
            "type": "string",
            "description": "客队队徽图片 URL"
          },
          "awayTeamId": {
            "type": "number",
            "description": "客队ID"
          },
          "oldAwayTeamId": {
            "type": "number",
            "description": "旧客队ID"
          },
          "awayTeamName": {
            "type": "string",
            "description": "客队名称（如 摩洛哥）"
          },
          "awayTeamShortNameEn": {
            "type": "string",
            "description": "客队英文简称（如 Morocco）"
          },
          "awayScore": {
            "type": "number",
            "description": "客队比分"
          },
          "awayOutScore": {
            "type": "number",
            "description": "客队常规时间外比分（加时/点球）"
          },
          "win": {
            "type": "string",
            "description": "胜负标识"
          },
          "matchResult": {
            "type": "string",
            "description": "比赛结果（如 HOME_TEAM 主队胜）"
          },
          "status": {
            "type": "string",
            "description": "比赛状态标识（如 END, LIVE 等）"
          },
          "statusDesc": {
            "type": "string",
            "description": "比赛状态描述（如 已结束、未开始）"
          },
          "thirdPCStatus": {
            "type": "string",
            "description": "第三方比赛状态（如 COMPLETED）"
          },
          "matchPeriod": {
            "type": "string",
            "description": "比赛阶段（如 SECOND_HALF 下半场）"
          },
          "periodBeginTime": {
            "type": "number",
            "description": "当前阶段开始时间（秒时间戳）"
          },
          "stageBeginTime": {
            "type": "number",
            "description": "阶段开始时间（秒时间戳）"
          },
          "periodBeginTimeStr": {
            "type": "string",
            "description": "阶段时间描述（如 \"已结束 16851'\"）"
          },
          "venueDTO": {
            "type": "object",
            "description": "比赛场馆信息",
            "properties": {
              "venueId": {
                "type": "number",
                "description": "场馆ID"
              },
              "name": {
                "type": "string",
                "description": "场馆名称"
              },
              "enName": {
                "type": "string",
                "description": "场馆英文名称"
              }
            }
          },
          "refereeDTO": {
            "type": "object",
            "description": "主裁判信息",
            "properties": {
              "refereeId": {
                "type": "number",
                "description": "裁判ID"
              },
              "name": {
                "type": "string",
                "description": "裁判姓名"
              }
            }
          },
          "matchDesc": {
            "type": "string",
            "description": "比赛描述（如 \"世界杯 1/4决赛\"）"
          },
          "dateDesc": {
            "type": "string",
            "description": "比赛时间描述（如 \"07月10日 04:00\"）"
          },
          "twoRoundsDesc": {
            "type": "string",
            "description": "两回合赛制描述"
          },
          "matchTvList": {
            "type": "array",
            "description": "电视转播列表（可能为 null）"
          },
          "isShowMatchTv": {
            "type": "number",
            "description": "是否展示电视转播（0/1）"
          },
          "pollTimeSeconds": {
            "type": "number",
            "description": "轮询间隔（秒）"
          },
          "competitionBg": {
            "type": "string",
            "description": "赛事背景图 URL"
          },
          "matchLiveUrl": {
            "type": "string",
            "description": "直播间跳转链接"
          },
          "matchVideo": {
            "type": "object",
            "description": "比赛视频信息（可能为 null）"
          },
          "minMatchStatus": {
            "type": "object",
            "description": "小状态（细分比赛状态）",
            "properties": {
              "id": {
                "type": "number",
                "description": "状态ID"
              },
              "txt": {
                "type": "string",
                "description": "状态文案"
              },
              "desc": {
                "type": "string",
                "description": "状态描述"
              },
              "used": {
                "type": "number",
                "description": "使用标识"
              }
            }
          },
          "bigMatchStatus": {
            "type": "object",
            "description": "大状态（粗分比赛状态）",
            "properties": {
              "id": {
                "type": "number",
                "description": "状态ID"
              },
              "txt": {
                "type": "string",
                "description": "状态文案"
              },
              "desc": {
                "type": "string",
                "description": "状态描述"
              },
              "used": {
                "type": "number",
                "description": "使用标识"
              }
            }
          },
          "index": {
            "type": "number",
            "description": "索引（可能为 null）"
          },
          "openTeamPage": {
            "type": "number",
            "description": "是否开启球队主页（0/1）"
          },
          "pv": {
            "type": "string",
            "description": "评分/浏览量文案（如 \"19.5万评分\"）"
          },
          "supportLiveActivity": {
            "type": "boolean",
            "description": "是否支持灵动岛实时活动"
          },
          "iosliveActivityCode": {
            "type": "string",
            "description": "iOS 实时活动编码（可能为 null）"
          },
          "homeTeamPenalty": {
            "type": "number",
            "description": "主队点球数"
          },
          "awayTeamPenalty": {
            "type": "number",
            "description": "客队点球数"
          },
          "homeTeamScore": {
            "type": "number",
            "description": "主队得分"
          },
          "awayTeamScore": {
            "type": "number",
            "description": "客队得分"
          },
          "homeTeamLogo": {
            "type": "string",
            "description": "主队队徽图片 URL"
          },
          "awayTeamLogo": {
            "type": "string",
            "description": "客队队徽图片 URL"
          },
          "draw": {
            "type": "boolean",
            "description": "是否平局"
          },
          "homeWin": {
            "type": "boolean",
            "description": "主队是否获胜"
          },
          "awayWin": {
            "type": "boolean",
            "description": "客队是否获胜"
          }
        }
      }
    },
    "required": [
      "code",
      "message"
    ]
  }
}